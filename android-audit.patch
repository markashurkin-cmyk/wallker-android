+fun walkerText(context:Context,value:String):String {
+ if(walkerLanguage(context)=="ru")return value
+ walkerEnglish[value]?.let{return it}
+ if(value.startsWith("Дней ожидают передачи: "))return "Days awaiting sync: "+value.substringAfter(": ")
+ if(value.contains("\n"))return value.split("\n").joinToString("\n"){walkerText(context,it)}
+ for((key,text)in walkerEnglish)if(key.endsWith(" ")&&value.startsWith(key))return text+walkerText(context,value.substring(key.length))
+ return if(Regex("[А-Яа-яЁё]").containsMatchIn(value))"Please retry or contact support in Telegram." else value
+}
