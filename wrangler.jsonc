{
  "name": "wallker-wallet",
  "main": "Wallker-Cloudflare-Server/worker.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "assets": {
    "directory": "./Wallker-Cloudflare-Server/public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wallker-wallet",
      "database_id": "6ceddc00-80eb-4abc-a0b5-a03cec5ddf6a"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "",
    "BOT_AUTO_SETUP": "true",
    "STARS_PAYMENTS_ENABLED": "true"
  },
  "keep_vars": true,
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "previews": {
    "vars": {
      "ALLOWED_ORIGINS": "",
      "BOT_AUTO_SETUP": "false",
      "STARS_PAYMENTS_ENABLED": "false",
      "GROWTH_PREVIEW": "true"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "walker-wallet-preview",
        "database_id": "3f8a5ba5-8abe-428e-8d1f-b9b2decc82e3"
      }
    ]
  }
}
