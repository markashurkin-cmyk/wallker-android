+]
+func WL(_ value:String)->String {
+ let language=UserDefaults.standard.string(forKey:"walker-language") ?? (Locale.preferredLanguages.first?.hasPrefix("ru")==true ? "ru":"en")
+ if language=="ru" {return value}
+ if let translated=walkerEnglish[value] {return translated}
+ if value.hasPrefix("Дней ожидают передачи: "){return "Days awaiting sync: "+value.components(separatedBy:": ").last!}
+ if value.contains("\n"){return value.components(separatedBy:"\n").map{WL($0)}.joined(separator:"\n")}
+ for (key,text) in walkerEnglish where key.hasSuffix(" ") && value.hasPrefix(key) {return text+WL(String(value.dropFirst(key.count)))}
+ if value.range(of:"[А-Яа-яЁё]",options:.regularExpression) != nil {return "Please retry or contact support in Telegram."}
+ return value
+}
