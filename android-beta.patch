+    private val paint=Paint(Paint.ANTI_ALIAS_FLAG).apply{style=Paint.Style.STROKE;strokeCap=Paint.Cap.ROUND}
+    override fun onDraw(canvas:Canvas){
+        super.onDraw(canvas)
+        val stroke=10*resources.displayMetrics.density;paint.strokeWidth=stroke
+        val diameter=minOf(width,height)-stroke*3
+        val left=(width-diameter)/2;val top=(height-diameter)/2
+        val bounds=RectF(left,top,left+diameter,top+diameter)
+        paint.color=Color.parseColor("#333e2c");canvas.drawOval(bounds,paint)
+        paint.color=Color.parseColor(if(active)"#bdff58" else "#526348")
+        canvas.drawArc(bounds,-90f,if(active)280f else 45f,false,paint)
+    }
