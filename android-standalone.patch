+package com.wallker.wallet
+
+import android.app.Application
+import android.content.Context
+import android.os.SystemClock
+import android.view.View
+import android.view.ViewGroup
+import android.widget.Button
+import android.widget.EditText
+import android.widget.TextView
+import androidx.work.Configuration
+import androidx.work.testing.SynchronousExecutor
+import androidx.work.testing.WorkManagerTestInitHelper
+import org.junit.Assert.*
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.Robolectric
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [28], application = Application::class)
+class StandaloneTrackerTest {
+    private lateinit var context:Context
+    @Before fun prepare(){
+        context=RuntimeEnvironment.getApplication()
+        for(name in listOf("wallker_steps","wallker","walker-ui","walker_pending_pair"))
+            context.getSharedPreferences(name,Context.MODE_PRIVATE).edit().clear().commit()
+        context.getSharedPreferences("walker-ui",Context.MODE_PRIVATE).edit().putString("language","ru").commit()
+        WorkManagerTestInitHelper.initializeTestWorkManager(context,
+            Configuration.Builder().setExecutor(SynchronousExecutor()).build())
+    }
+    private fun all(view:View):List<View> = listOf(view)+(if(view is ViewGroup)(0 until view.childCount).flatMap{all(view.getChildAt(it))} else emptyList())
+    private fun visible(view:View):Boolean = view.visibility==View.VISIBLE && (view.parent !is View || visible(view.parent as View))
+    @Test fun freshInstallHasUsableCounterAndNoPairingGate(){
+        val controller=Robolectric.buildActivity(MainActivity::class.java).setup()
+        val views=all(controller.get().window.decorView)
+        assertNull(DeviceVault(context).token())
+        assertTrue(views.filterIsInstance<Button>().any{it.text.toString()=="Включить шагомер" && it.isEnabled && visible(it)})
+        assertTrue(views.filterIsInstance<TextView>().any{it.text.toString()=="ШАГОМЕР БЕЗ РЕГИСТРАЦИИ" && visible(it)})
+        assertTrue(views.filterIsInstance<TextView>().any{it.text.toString()=="История шагов" && visible(it)})
+        assertFalse(views.filterIsInstance<EditText>().any{visible(it)})
+        controller.pause().stop().destroy()
+    }
+    @Test fun sensorLedgerPersistsWithoutAccountOrSync(){
+        val store=StepStore(context)
+        store.setEnabled(true)
+        val stamp=SystemClock.elapsedRealtimeNanos()
+        store.record(100,stamp)
+        store.record(113,stamp)
+        assertNull(DeviceVault(context).token())
+        assertEquals(13L,store.today())
+        assertEquals(13L,StepStore(context).history().first().second)
+        assertEquals(13L,StepStore(context).today())
+    }
+    @Test fun optionalSharingOpensOnlyWhenRequested(){
+        val controller=Robolectric.buildActivity(MainActivity::class.java).setup()
+        val views=all(controller.get().window.decorView)
+        val input=views.filterIsInstance<EditText>().single()
+        assertFalse(visible(input))
+        views.filterIsInstance<Button>().single{it.text.toString()=="Настроить передачу шагов"}.performClick()
+        assertTrue(visible(input))
+        views.filterIsInstance<Button>().single{it.text.toString()=="Настроить передачу шагов"}.performClick()
+        assertFalse(visible(input))
+        assertNull(DeviceVault(context).token())
+        controller.pause().stop().destroy()
+    }
+    @Test fun englishStandaloneScreenIsAvailableWithoutAccount(){
+        context.getSharedPreferences("walker-ui",Context.MODE_PRIVATE).edit().putString("language","en").commit()
+        val controller=Robolectric.buildActivity(MainActivity::class.java).setup()
+        val views=all(controller.get().window.decorView)
+        assertTrue(views.filterIsInstance<TextView>().any{it.text.toString()=="STEP TRACKER WITHOUT SIGN UP" && visible(it)})
+        assertTrue(views.filterIsInstance<TextView>().any{it.text.toString()=="Step history" && visible(it)})
+        assertNull(DeviceVault(context).token())
+        controller.pause().stop().destroy()
+    }
+}
