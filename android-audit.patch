+class BootReceiver:BroadcastReceiver(){override fun onReceive(context:Context,intent:Intent){
+ if(intent.action!=Intent.ACTION_BOOT_COMPLETED)return
+ val store=StepStore(context);StepSyncWorker.schedule(context)
+ val allowed=Build.VERSION.SDK_INT<29 || context.checkSelfPermission(Manifest.permission.ACTIVITY_RECOGNITION)==PackageManager.PERMISSION_GRANTED
